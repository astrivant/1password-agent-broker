{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "state": {
      "enum": [
        "completed",
        "denied",
        "failed",
        "uncertain",
        "cancelled"
      ]
    },
    "code": {
      "enum": [
        "healthy",
        "unhealthy",
        "denied",
        "invalid_request",
        "provider_failed",
        "unknown",
        "cancelled",
        "audit_failed",
        "crypto_completed"
      ]
    },
    "status_code": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 100,
      "maximum": 599
    },
    "replayed": {
      "type": "boolean"
    },
    "audit_warning": {
      "type": "boolean"
    }
  },
  "required": [
    "state",
    "code",
    "status_code",
    "replayed",
    "audit_warning"
  ],
  "additionalProperties": false
}
